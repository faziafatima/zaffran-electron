<header class="header sticky-header" id="header">
  
  <div class="brand">
          <div class=""><img src="/img/logo.png" alt="Logo" class="logo" /></div>
          <div>
            <h1><a href="/dashboard"><%= restaurant?.name || 'RestaurantOS' %></a></h1>
          </div>
  </div>
  <% if(role == 'super admin' || role == 'Super Admin') { %>
  <div class="restaurant-menu">
    <span id="restaurant-select"><%= restaurant?.name || 'RestaurantOS' %> <span class="dropdown-caret" id="caret1"></span></span>
    <ul id="dropdown1" class="dropdown hidden">
      <% restaurantList.forEach(item => { %>
        <% const itemId = String(item.id || ''); %>
        <% const selectedId = String(restaurantId || ''); %>
        <li class="restaurant-option <%= itemId === selectedId ? 'active-item' : '' %>" data-restaurant-id="<%= itemId %>" data-restaurant-name="<%= item.name || '' %>">
          <button type="button" class="dropdown-item-button"><%= item.name %></button>
        </li>
        <% }) %>
    </ul>
  </div>
  <% } %>
  <div class="user-menu">
    <span id="username"><%= user %> <span class="dropdown-caret" id="caret2"></span></span>
    <ul id="dropdown2" class="dropdown hidden">
      <% items.forEach(item => { %>
        <li><a href="<%= item.path %>"><%= item.icon %> <%= item.label %></a></li>
        <% }) %>
      <li><a href="/logout">🚪 Logout</a></li>
    </ul>
  </div>
</header>
<input type="hidden" id="header-user-name" value="<%= user %>" class="d-none" />
<input type="hidden" id="header-restaurant-id" value="<%= restaurantId || '' %>" class="d-none" />
<input type="hidden" id="header-role" value="<%= role || '' %>" class="d-none" />
<script>
   const headerRestaurantId = document.getElementById('header-restaurant-id')?.value || '';
   const roleHeader = document.getElementById('header-role')?.value || '';
const dropdownConfigs = [
  {
    trigger: document.getElementById('restaurant-select'),
    menu: document.getElementById('dropdown1'),
    caret: document.getElementById('caret1')
  },
  {
    trigger: document.getElementById('username'),
    menu: document.getElementById('dropdown2'),
    caret: document.getElementById('caret2')
  }
].filter(item => item.trigger && item.menu && item.caret);

function closeAllDropdowns(exceptMenu = null) {
  dropdownConfigs.forEach(item => {
    if (exceptMenu && item.menu === exceptMenu) {
      return;
    }
    item.menu.classList.add('hidden');
    item.caret.classList.remove('dropdown-caret-rotate');
  });
}

dropdownConfigs.forEach(item => {
  item.trigger.addEventListener('click', event => {
    event.stopPropagation();
    const shouldOpen = item.menu.classList.contains('hidden');
    closeAllDropdowns();
    if (shouldOpen) {
      item.menu.classList.remove('hidden');
      item.caret.classList.add('dropdown-caret-rotate');
    }
  });

  item.menu.addEventListener('click', event => {
    event.stopPropagation();
  });
});

document.addEventListener('click', () => {
  closeAllDropdowns();
});

const restaurantOptions = document.querySelectorAll('#dropdown1 .restaurant-option');

async function updateSessionRestaurant(restaurantId) {
  console.log('Attempting to update session restaurant to:', restaurantId);
  const response = await fetch('/session/restaurant', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ restaurantId })
  });

  if (!response.ok) {
    const errorPayload = await response.json().catch(() => ({}));
    throw new Error(errorPayload.message || 'Failed to update restaurant');
  }

  return response.json();
}

restaurantOptions.forEach(option => {
  option.addEventListener('click', async event => {
    event.preventDefault();
    event.stopPropagation();

    const selectedRestaurantId = option.dataset.restaurantId;
    const currentRestaurantId = document.getElementById('header-restaurant-id')?.value || '';
    if (!selectedRestaurantId || selectedRestaurantId === currentRestaurantId) {
      closeAllDropdowns();
      return;
    }

    try {
      await updateSessionRestaurant(selectedRestaurantId);
      window.location.reload();
    } catch (error) {
      console.error('Restaurant switch failed:', error);
      alert('Unable to switch restaurant. Please try again.');
    }
  });
});


