

<style>
  /* Header styling */
.header {
 display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #d9dbdd;
    border-bottom: 2px solid #10182b;
    /* color: #fff; */
    padding: 1px 6px;
    font-family: Arial, sans-serif;
    font-size: 12px;
}

/* Logo */
.logo {
    height: 30px;
}

/* User menu */
.user-menu {
  position: relative;
  cursor: pointer;
  padding: 0 20px;
}

.restaurant-menu {
  position: relative;
  cursor: pointer;
  padding: 0 20px;
}

/* Username */
#username {
  font-weight: 500;
}

/* Dropdown */
.dropdown {
  position: absolute;
  right: 0;
  top: 100%;
  background-color: #fff;
  color: #333;
  list-style: none;
  margin: 0;
  padding: 0px;
  border: 1px solid #ccc;
  border-radius: 4px;
  min-width: 160px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}

.dropdown li {
  padding: 8px 12px;
  border-bottom: 1px solid #cac4c4;
}

.dropdown li:hover {
  background-color: #f0f0f0;
}

.dropdown-item-button {
  width: 100%;
  border: 0;
  background: transparent;
  text-align: left;
  padding: 0;
  margin: 0;
  cursor: pointer;
  color: inherit;
  font: inherit;
}

.dropdown li.active-item {
  background-color: #eceff2;
  font-weight: 600;
}

.dropdown a {
  text-decoration: none;
  color: inherit;
  display: block;
}

/* Hidden state */
.hidden {
  display: none;
}


/* --- THE CARET CSS --- */
.dropdown-caret {
  display: inline-block;
  width: 8px;
  height: 5px;
  background-color: currentColor; /* Inherits #333 color automatically */
  clip-path: polygon(0 0, 100% 0, 50% 100%); /* Sharp downward triangle */
  transition: transform 0.2s ease; /* Enables smooth flipping animation */
}

/* Rotates the triangle upside down when the menu is visible */
.dropdown-caret-rotate {        /* Or use this if you toggle .active on username */
  transform: rotate(180deg);
}

</style>

