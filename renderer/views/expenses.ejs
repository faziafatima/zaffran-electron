<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
    <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
<div class="page-heading">Expenses</div>
  <div class="tabs">
    <div class="tab active" data-tab="restExp">Restaurant Expenses</div>
    <div class="tab" data-tab="staffExp">Staff Expenses</div>
  </div>

<div id="restExp" class="tab-content active">
<form id="expenseForm">
  <div  class="four-grid">
          <div class="field"><label for="expenseDetails">Expense details</label><input id="expenseDetails" required /></div>
          <div class="field"><label for="expenseAmount">Amount</label><input id="expenseAmount" type="number" min="0" step="0.01"  required /></div>
          <div class="field"><label for="expenseDate">Date</label><input id="expenseDate" type="date" required /></div>
          <div class="field">
            <label for="expensePaymentMode">Payment mode</label>
            <select id="expensePaymentMode" required>
              <option value="cash">Cash</option>
              <option value="upi">UPI</option>
            </select>
          </div>
              </div>
          <button class="btn-primary" type="submit">Save Expense</button>
          <p class="muted" id="expenseSaveMessage"></p>
        
        </form>
        <hr/>
        <section class="row">
          <div class="panel col">
            <div class="section-head">
              <div><h3>Restaurant Expenses</h3></div>
              <div class="menu-toolbar">
                <input id="expensesSearchInput" class="menu-search" type="search" placeholder="Search expenses" aria-label="Search restaurant expenses" />
                <label class="date-filter">From<input id="expensesDateFrom" type="date" aria-label="Restaurant expense date from" /></label>
                <label class="date-filter">To<input id="expensesDateTo" type="date" aria-label="Restaurant expense date to" /></label>
                <button type="button" class="menu-action-btn" id="downloadExpensesReportButton">Download CSV</button>
              </div>
            </div>
            <div class="table-wrap"><table class="table">
              <thead>
                <tr><th>Expense</th><th>Amount</th><th>Payment Mode</th><th>Expense Date</th><% if (role === 'Admin' || role === 'Super Admin') { %><th>Actions</th><% } %></tr>
              </thead>
              <tbody id="expensesTableBody"></tbody>
            </table></div>
            <div class="table-footer">
              <span class="muted" id="expensesPageSummary">Showing 0 of 0 expenses</span>
              <div class="pagination-controls">
                <button type="button" class="secondary pagination-button" id="expensesPrevButton">Previous</button>
                <span class="muted" id="expensesPageIndicator">Page 0 of 0</span>
                <button type="button" class="secondary pagination-button" id="expensesNextButton">Next</button>
              </div>
            </div>
          </div>
        </section>
  </div>

  <div id="staffExp" class="tab-content">
    <div class="section-head"><span class="section-tag">Record cash/advance taken</span></div>
            <form id="staffExpenseForm">
              <div  class="five-grid">
              <div class="field">
                <label for="staffExpenseStaffId">Staff member</label>
                <select id="staffExpenseStaffId" required></select>
              </div>
              <div class="field"><label for="staffExpenseDate">Date</label><input id="staffExpenseDate" type="date" required /></div>
              <div class="field"><label for="staffExpenseAmount">Expense amount</label><input id="staffExpenseAmount" type="number" min="0" step="0.01" required /></div>
              <div class="field">
                <label for="staffExpensePaymentMode">Payment mode</label>
                <select id="staffExpensePaymentMode" required>
                  <option value="cash" selected>Cash</option>
                  <option value="upi">UPI</option>
                </select>
              </div>
              <div class="field"><label for="staffExpenseDetails">Details</label><textarea id="staffExpenseDetails" rows="2" maxlength="300" placeholder="Reason for expense" required></textarea></div>
            </div>
              <button class="btn-primary" id="staffExpenseSubmitButton" type="submit">Save expense</button>
              <button class="secondary" id="cancelStaffExpenseEditButton" type="button" hidden>Cancel edit</button>
              <p class="muted" id="staffExpenseSaveMessage"></p>
            </form>
            <hr />
            <div class="section-head">
              <div><h3>Staff Expenses</h3></div>
              <div class="menu-toolbar">
                <input id="staffExpensesSearchInput" class="menu-search" type="search" placeholder="Search staff expenses" aria-label="Search staff expenses" />
                <label class="date-filter">From<input id="staffExpensesDateFrom" type="date" aria-label="Staff expense date from" /></label>
                <label class="date-filter">To<input id="staffExpensesDateTo" type="date" aria-label="Staff expense date to" /></label>
                <button type="button" class="menu-action-btn" id="downloadStaffExpensesReportButton">Download CSV</button>
              </div>
            </div>
            <div class="table-wrap"><table class="table">
              <thead>
                <tr>
                  <th>Staff Name</th><th>Amount</th><th>Payment Mode</th><th>Details</th><th>Date</th>
                  <% if (role === 'Admin' || role === 'Super Admin') { %><th>Actions</th><% } %>
                </tr>
              </thead>
              <tbody id="staffExpensesTableBody"></tbody>
            </table></div>
            <div class="table-footer">
              <span class="muted" id="staffExpensesPageSummary">Showing 0 of 0 staff expenses</span>
              <div class="pagination-controls">
                <button type="button" class="secondary pagination-button" id="staffExpensesPrevButton">Previous</button>
                <span class="muted" id="staffExpensesPageIndicator">Page 0 of 0</span>
                <button type="button" class="secondary pagination-button" id="staffExpensesNextButton">Next</button>
              </div>
            </div>
            <!-- <div id="staffExpenseList" class="list"></div> -->
  </div>
        
      </main>
    </div>

    <div class="modal-backdrop" id="expenseModalBackdrop" hidden></div>
    <div class="modal-shell" id="expenseModal" role="dialog" aria-modal="true" aria-labelledby="expenseModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="expenseModalTitle">Add expense</h3>
            <span class="section-tag">Create or update expense details</span>
          </div>
          <button type="button" class="icon-button" id="closeExpenseFormButton" aria-label="Close expense form">x</button>
        </div>
        
      </div>
    </div>

    <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
    </script>
    <script src="/js/shared.js"></script>
    <script src="/js/expenses.js"></script>
    <script src="/js/staff-expenses.js"></script>
  </body>
</html>