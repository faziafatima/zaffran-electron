<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
    <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
<div class="page-heading">Expenses</div>
  <div class="tabs">
    <div class="tab active" data-tab="restExp">Restaurant Expenses</div>
    <div class="tab" data-tab="staffExp">Staff Expenses</div>
  </div>

<div id="restExp" class="tab-content active">
<form id="expenseForm">
  <div  class="triple-grid">
          <div class="field"><label for="expenseDetails">Expense details</label><input id="expenseDetails" required /></div>
          <div class="field"><label for="expenseAmount">Amount</label><input id="expenseAmount" type="number" min="0" step="0.01"  required /></div>
          <div class="field"><label for="expenseDate">Date</label><input id="expenseDate" type="date" required /></div>
              </div>
          <button class="secondary" type="submit">Save Expense</button>
          <p class="muted" id="expenseSaveMessage"></p>
        
        </form>
        <hr/>
        <section class="row">
          <div class="panel col">
            <table class="table">
              <thead>
                <tr><th>Expense</th><th>Amount</th><th>Created</th><% if (role === 'Admin' || role === 'Super Admin') { %><th>Actions</th><% } %></tr>
              </thead>
              <tbody id="expensesTableBody"></tbody>
            </table>
          </div>
        </section>
  </div>

  <div id="staffExp" class="tab-content">
    <div class="section-head"><span class="section-tag">Record cash/advance taken</span></div>
            <form id="staffExpenseForm">
              <div  class="four-grid">
              <div class="field">
                <label for="staffExpenseStaffId">Staff member</label>
                <select id="staffExpenseStaffId" required></select>
              </div>
              <div class="field"><label for="staffExpenseDate">Date</label><input id="staffExpenseDate" type="date" required /></div>
              <div class="field"><label for="staffExpenseAmount">Expense amount</label><input id="staffExpenseAmount" type="number" min="0" step="0.01" required /></div>
              <div class="field"><label for="staffExpenseDetails">Details</label><textarea id="staffExpenseDetails" rows="2" maxlength="300" placeholder="Reason for expense" required></textarea></div>
            </div>
              <button class="secondary" type="submit">Save expense</button>
              <p class="muted" id="staffExpenseSaveMessage"></p>
            </form>
            <hr />
            <table class="table">
              <thead>
                <tr><th>Staff Name</th><th>Amount</th><th>Details</th><th>Date</th></tr>
              </thead>
              <tbody id="staffExpensesTableBody"></tbody>
            </table>
            <!-- <div id="staffExpenseList" class="list"></div> -->
  </div>
        
      </main>
    </div>

    <div class="modal-backdrop" id="expenseModalBackdrop" hidden></div>
    <div class="modal-shell" id="expenseModal" role="dialog" aria-modal="true" aria-labelledby="expenseModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="expenseModalTitle">Add expense</h3>
            <span class="section-tag">Create or update expense details</span>
          </div>
          <button type="button" class="icon-button" id="closeExpenseFormButton" aria-label="Close expense form">x</button>
        </div>
        
      </div>
    </div>

    <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
    </script>
    <script src="/js/shared.js"></script>
    <script src="/js/expenses.js"></script>
    <script src="/js/staff-expenses.js"></script>
  </body>
</html>