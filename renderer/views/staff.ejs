<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
   <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
        <div class="topbar">
          
          <div class="page-heading">Staff Management</div>
         
          <div class="topbar-actions">
            <div class="user-chip" id="teamChip"></div>
            <button class="secondary" type="button" id="openStaffFormButton">Add Staff</button>
            <a href="/masterPages" class="button">Back</a>
          </div>
        </div>
        <section class="row">
          <div class="panel col">
            <div class="section-head">
              <div>
                <h3>Staff Records</h3>
              </div>
              <div class="menu-toolbar">
                <input id="staffSearchInput" class="menu-search" type="search" aria-label="Search staff" placeholder="Search by name, phone or shift" />
              </div>
            </div>
            <table class="table">
              <thead>
                <tr><th>Name</th><th>Contact</th><th>Shift</th><th>Actions</th></tr>
              </thead>
              <tbody id="staffTableBody"></tbody>
            </table>
            <div class="table-footer">
              <span class="muted" id="staffPageSummary">Showing 0 of 0 staff</span>
              <div class="pagination-controls">
                <button type="button" class="secondary pagination-button" id="staffPrevButton">Previous</button>
                <span class="muted" id="staffPageIndicator">Page 0 of 0</span>
                <button type="button" class="secondary pagination-button" id="staffNextButton">Next</button>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
    <div class="modal-backdrop" id="staffModalBackdrop" hidden></div>
    <div class="modal-shell" id="staffModal" role="dialog" aria-modal="true" aria-labelledby="staffModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="staffModalTitle">Add Staff</h3>
          </div>
          <button type="button" class="icon-button" id="closeStaffFormButton" aria-label="Close staff form">×</button>
        </div>
        <form id="staffForm">
          <div class="four-grid">
          <div class="field"><label for="fullName">Name</label><input id="fullName" required /></div>
          <div class="field"><label for="address">Address</label><input id="address" required /></div>
          <div class="field"><label for="adhaarNumber">Aadhaar</label><input id="adhaarNumber" required /></div>
         
          <div class="field"><label for="phoneNumber">Phone</label><input id="phoneNumber" type="tel"  required /></div>
          <div class="field"><label for="joiningDate">Joining date</label><input id="joiningDate" type="date" required /></div>
          <div class="field"><label for="bankAccountNumber">Bank Account No</label><input id="bankAccountNumber" /></div>
          <div class="field"><label for="bankName">Bank Name</label><input id="bankName" /></div>
          <div class="field"><label for="bankIFSC">Bank IFSC</label><input id="bankIFSC" /></div>
          <div class="field"><label for="bankBranch">Bank Branch</label><input id="bankBranch" /></div>
          <div class="field"><label for="shift">Shift</label><input id="shift" /></div>
          <div class="field"><label for="salary">Salary</label><input id="salary" type="number" step="0.01" min="0" value="0" required /></div>
          </div>
            <div class="modal-actions">
            <button type="submit">Save Staff</button>
            <button class="ghost-button" type="button" id="cancelStaffFormButton">Cancel</button>
          </div>
          <p class="muted" id="staffSaveMessage"></p>
        </form>
      </div>
    </div>
    <div class="modal-backdrop" id="salaryModalBackdrop" hidden></div>
    <div class="modal-shell" id="salaryModal" role="dialog" aria-modal="true" aria-labelledby="salaryModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="salaryModalTitle">Eligible Salary</h3>
            <span class="section-tag">Salary minus recorded staff expenses</span>
          </div>
          <button type="button" class="icon-button" id="closeSalaryModalButton" aria-label="Close salary view">×</button>
        </div>
        <div class="reports-filter-grid">
          <div class="field">
            <label for="salaryMonthSelector">Salary Month</label>
            <input id="salaryMonthSelector" type="month" />
          </div>
          <div class="field salary-until-today-field">
            <label for="salaryUntilTodayToggle">Calculation End</label>
            <label class="salary-checkbox-row">
              <input id="salaryUntilTodayToggle" type="checkbox" checked />
              <span>Until today's date</span>
            </label>
          </div>
        </div>
        <div class="salary-preset-row" role="group" aria-label="Salary period presets">
          <button type="button" class="ghost-button salary-preset-btn" id="salaryPresetFullMonthButton">Full Month</button>
          <button type="button" class="ghost-button salary-preset-btn" id="salaryPresetMtdButton">MTD</button>
        </div>
        <p class="muted" id="salaryPeriodLabel">Period: -</p>
        <div class="four-grid">
          <div class="details-card">
            <span>Staff Member</span>
            <strong id="salaryStaffName">-</strong>
          </div>
          <div class="details-card">
            <span>Total Salary</span>
            <strong id="salaryTotalValue">INR 0.00</strong>
          </div>
          <div class="details-card">
            <span>Total Expenses</span>
            <strong id="salaryExpenseValue">INR 0.00</strong>
          </div>
          <div class="details-card salary-eligible-card">
            <span>Eligible Salary</span>
            <strong id="salaryEligibleValue">INR 0.00</strong>
          </div>
        </div>
        <div class="detail-section">
          <h4>Expense History</h4>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr><th>Date</th><th>Amount</th><th>Details</th></tr>
              </thead>
              <tbody id="salaryExpenseTableBody"></tbody>
            </table>
          </div>
        </div>
        <div class="detail-section">
          <h4>Attendance & Salary Basis</h4>
          <div class="triple-grid">
            <div class="details-card">
              <span>Days In Month</span>
              <strong id="salaryDaysInMonthValue">0</strong>
            </div>
            <div class="details-card">
              <span>Present Days</span>
              <strong id="salaryPresentDaysValue">0</strong>
            </div>
            <div class="details-card">
              <span>Per Day Salary</span>
              <strong id="salaryPerDayValue">INR 0.00</strong>
            </div>
            <div class="details-card">
              <span>Full Monthly Salary</span>
              <strong id="salaryMonthlyValue">INR 0.00</strong>
            </div>
            <div class="details-card">
              <span>Projected Salary (If Present Remaining Days)</span>
              <strong id="salaryProjectedValue">INR 0.00</strong>
            </div>
          </div>
        </div>
        <div class="modal-actions">
          <button class="ghost-button" type="button" id="closeSalaryModalFooterButton">Close</button>
        </div>
      </div>
    </div>
    <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
    </script>
    <script src="/js/shared.js"></script>
    <script src="/js/staff.js"></script>
  </body>
</html>
