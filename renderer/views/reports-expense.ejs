<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
    <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
        <div class="page-heading">Expense Reports</div>
          <section class="panel reports-filter-panel">
          <div class="reports-filter-grid">
            <div class="field">
              <label for="reportReferenceDateFrom">Date range</label>
              <input id="reportReferenceDateFrom" type="date" />
              <input id="reportReferenceDateTo" type="date" />
            </div>
            <div class="reports-filter-actions">
              <button type="button" id="refreshReportButton">Search</button>
              <a href="/reportsView" class="button">Back</a>
            </div>
          </div>
          <p class="muted" id="reportsMessage"></p>
        </section>

        
        <article class="panel" id="expenseDetailsPanel">
          <section class="section-head">
          <div>
            <h3>Expense Details</h3>
            <p class="muted">Total Expenses: <strong id="expenseTotalAmount">₹0.00</strong></p>
          </div>
          <button type="button" class="secondary" id="expenseExportCsvButton">Export CSV</button>
        </section>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Category</th>
                  <th>Details</th>
                  <th>Staff Member</th>
                  <th>Payment Mode</th>
                  <th>Amount</th>
                </tr>
              </thead>
              <tbody id="expenseReportRows"></tbody>
            </table>
          </div>
        </article>

      </main>
    </div>
    <script src="/js/shared.js"></script>
    <script src="/js/reports-expense.js"></script>
  </body>
</html>
