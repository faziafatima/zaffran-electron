<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
   <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
        <div class="topbar">
          <div class="page-heading">Attendance Management</div>
        </div>
        <div class="panel col ">
            <h3>Record attendance</h3>
            <form id="attendanceForm">
              <div class="attendance-quick-row">
                <button class="blue" type="button" id="attendanceCheckInNow">Check-in now</button>
                <button class="blue" type="button" id="attendanceCheckOutNow">Check-out now</button>
              </div>
              <div class="row-grid-attendance">
              <div class="field">
                <label for="attendanceStaffId">Staff member</label>
                <select id="attendanceStaffId" required></select>
              </div>
              <div class="field"><label for="attendanceDate">Date</label><input id="attendanceDate" type="date" <%= restrictAttendanceToToday ? 'min=' + minDate : '' %> required /></div>
              <div class="field" id="attendanceCheckInField"><label for="attendanceCheckIn">Check-in</label><input id="attendanceCheckIn" type="time" required /></div>
              <div class="field" id="attendanceCheckOutField"><label for="attendanceCheckOut">Check-out</label><input id="attendanceCheckOut" type="time" /></div>
              <div class="field">
                <label for="attendanceStatus">Status</label>
                <select id="attendanceStatus">
                  <option>Present</option>
                  <option>Absent</option>
                  <option>Leave</option>
                </select>
              </div>
              <div class="field" id="attendanceRemarksField" hidden>
                <label for="attendanceRemarks">Remarks</label>
                <textarea id="attendanceRemarks" rows="2" maxlength="300" placeholder="Required for Absent/Leave. Example: Sick leave, emergency, etc."></textarea>
              </div>
              
            </div>
            <button class="btn-primary" type="submit">Save attendance</button>
              <p class="muted" id="attendanceSaveMessage"></p>
            </form>
          </div>
          <div class="double-grid" style="gap: 20px; margin-top: 20px;">
        <section class="row">
          
          <div class="panel col">
            <div class="section-head"><h3>Weekly attendance</h3><span class="section-tag">Live summary</span></div>
            <div class="attendance-legend">
              <span><i class="legend-dot present"></i>Present</span>
              <span><i class="legend-dot absent"></i>Absent</span>
              <span><i class="legend-dot leave"></i>Leave</span>
            </div>
            <div id="attendanceWeekGraph" class="attendance-week-graph"></div>
          </div>
          <!-- <div class="panel col">
            <div class="section-head"><h3>Staff expenses</h3><span class="section-tag">Record cash/advance taken</span></div>
            <form id="staffExpenseForm">
              <div class="field">
                <label for="staffExpenseStaffId">Staff member</label>
                <select id="staffExpenseStaffId" required></select>
              </div>
              <div class="field"><label for="staffExpenseDate">Date</label><input id="staffExpenseDate" type="date" required /></div>
              <div class="field"><label for="staffExpenseAmount">Expense amount</label><input id="staffExpenseAmount" type="number" min="0" step="0.01" value="0" required /></div>
              <div class="field"><label for="staffExpenseDetails">Details</label><textarea id="staffExpenseDetails" rows="2" maxlength="300" placeholder="Reason for expense" required></textarea></div>
              <button class="secondary" type="submit">Save expense</button>
              <p class="muted" id="staffExpenseSaveMessage"></p>
            </form>
            <div id="staffExpenseList" class="list"></div>
          </div> -->
        </section>
        <section class="panel">
          <div class="section-head"><h3>Attendance records</h3><span class="section-tag" id="attendanceCount"></span><button type="button" class="secondary" style="float:right;" id="attendanceExportButton">Export CSV</button></div>
          <div class="row-grid-attendance">
            <div class="field">
              <label for="attendanceFilterStaffId">Staff member</label>
              <select id="attendanceFilterStaffId"><option value="">All staff</option></select>
            </div>
            <div class="field"><label for="attendanceFilterFrom">From</label><input id="attendanceFilterFrom" type="date" /></div>
            <div class="field"><label for="attendanceFilterTo">To</label><input id="attendanceFilterTo" type="date" /></div>
            <div class="field"><button class="btn-primary" type="button" id="attendanceSearchButton">Search</button></div>
          </div>
          <p class="muted" id="attendanceSearchMessage"></p>
          <div class="table-wrap attendance-table-wrap">
            <table class="table">
              <thead>
                <tr><th>Date</th><th>Staff</th><th>Status</th><th>Check-in</th><th>Check-out</th><th>Remarks</th></tr>
              </thead>
              <tbody id="attendanceList"></tbody>
            </table>
          </div>
          <div id="attendancePager" class="attendance-pager" hidden></div>
        </section>
        </div>
      </main>
    </div>
    <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
    </script>
    <script src="/js/shared.js"></script>
    <script src="/js/attendance.js"></script>
  </body>
</html>
