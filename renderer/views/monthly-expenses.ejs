<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
    <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
         <div class="topbar">
          <div class="page-heading">Monthly Expenses</div>
          <div class="topbar-actions">
            <a href="/masterPages" class="button">Back</a>
          </div>
        </div>
        <form id="monthlyExpenseForm" class="panel col">
          <p class="muted">Record fixed monthly costs (rent, utilities, salaries, maintenance, etc.). These feed into the Profit &amp; Loss report.</p>
          <div class="four-grid">
            <div class="field"><label for="monthlyExpenseCategory">Category</label>
              <select id="monthlyExpenseCategory" required>
                <option value="">Select category</option>
                <option value="Rent">Rent</option>
                <option value="Utilities">Utilities</option>
                <option value="Salaries">Salaries</option>
                <option value="Maintenance">Maintenance</option>
                <option value="Insurance">Insurance</option>
                <option value="Marketing">Marketing</option>
                <option value="Licenses & Fees">Licenses &amp; Fees</option>
                <option value="Other">Other</option>
              </select>
            </div>
            <div class="field"><label for="monthlyExpenseMonth">Month</label><input id="monthlyExpenseMonth" type="month" required /></div>
            <div class="field"><label for="monthlyExpenseAmount">Amount</label><input id="monthlyExpenseAmount" type="number" min="0" step="0.01" required /></div>
            <div class="field"><label for="monthlyExpenseDetails">Details</label><input id="monthlyExpenseDetails" placeholder="Optional notes" /></div>
          </div>
          <button class="btn-primary" type="submit" id="monthlyExpenseSubmitButton">Save Expense</button>
          <button type="button" class="button" id="cancelMonthlyExpenseEditButton" hidden>Cancel</button>
          <p class="muted" id="monthlyExpenseSaveMessage"></p>
        </form>
        <hr/>
        <section class="row">
          <div class="panel col">
            <table class="table">
              <thead>
                <tr><th>Month</th><th>Category</th><th>Details</th><th>Amount</th><% if (role === 'Admin' || role === 'Super Admin') { %><th>Actions</th><% } %></tr>
              </thead>
              <tbody id="monthlyExpensesTableBody"></tbody>
            </table>
          </div>
        </section>
      </main>
    </div>

    <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
    </script>
    <script src="/js/shared.js"></script>
    <script src="/js/monthly-expenses.js"></script>
  </body>
</html>
