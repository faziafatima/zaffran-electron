<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link href="/css/select2.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
     <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
        <div class="topbar orders-topbar">
                  
          <div class="label-container">
              <div class="label-box Dine-in-ticker">&nbsp;</div>Dine-in Orders
              <div class="label-box car-ticker">&nbsp;</div>Car Orders
              <div class="label-box Takeaway-ticker">&nbsp;</div>Takeaway Orders
          </div>
          <div class="page-heading">Open Orders</div>
          <div class="topbar-actions">
            <a class="secondary button" href="/orders/new" style="background-color: black; color:aliceblue">Create New Order</a>
            <a class="secondary button" href="/orders/closed">Closed Orders</a>
          </div>
        </div>
        <section class="orders-panel">
          <div class="orders-grid" id="ordersGrid"></div>
        </section>
      </main>
    </div>
   

    <!-- Modals -->
    <div class="modal-backdrop" id="closeOrderModalBackdrop" hidden></div>
    <div class="modal-shell" id="closeOrderModal" role="dialog" aria-modal="true" aria-labelledby="closeOrderModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="closeOrderModalTitle">Close Order</h3>
          </div>
          <button type="button" class="icon-button" id="closeCloseOrderFormButton" aria-label="Close close-order form">×</button>
        </div>
        <form id="closeOrderForm">
          <div class="field hide">
            <label for="closeOrderPaperWidth">Receipt paper width</label>
            <select id="closeOrderPaperWidth">
              <option value="58" >58mm thermal roll</option>
              <option value="80" selected>80mm thermal roll</option>
            </select>
          </div>
          <section class="panel" id="closeOrderPreviewPanel">
          
             <div class="text-center kot-panel">
              <img src="/img/logo-bw.png" alt="logo-print" class="logo-print" />
              <p><b><%= restaurant?.name || 'Zaffran' %></b></p>
              <p><b><%= restaurant?.address || '' %></b></p>
              <p><b>Phone: <%= restaurant?.phoneNumber || '' %></b></p>
              <p><b>GSTIN: <%= restaurant?.gstin || '' %></b></p>
              <p><b>FSSAI: <%= restaurant?.fssai || '' %></b></p>
              <hr/>
              <p><b>Tax Invoice</b></p>
            <div id="closeOrderPreview"></div>
          </section>
          <div class="panel order-form-grid">
            <!-- <div class="field"><label for="closeOrderSubtotal">Subtotal</label><input id="closeOrderSubtotal" type="number" step="0.01" readonly /></div> -->
            <!-- <div class="field"><label for="closeOrderTaxPercentage">Tax %</label><input id="closeOrderTaxPercentage" type="number" step="0.01" min="0" readonly /></div> -->
            <!-- <div class="field"><label for="closeOrderTaxAmount">Tax amount</label><input id="closeOrderTaxAmount" type="number" step="0.01" readonly /></div> -->
            <div class="field"><label for="closeOrderDiscountId">Discount</label><select id="closeOrderDiscountId"><option value="" selected>No discount</option></select></div>
            <!-- <div class="field"><label for="closeOrderDiscountAmount">Discount amount</label><input id="closeOrderDiscountAmount" type="number" step="0.01" min="0" readonly /></div> -->
            <div class="field"  style="display: none;"><label for="closeOrderTotalPayable">Total payable</label><input id="closeOrderTotalPayable" type="number" step="0.01" readonly /></div>
             <div class="field"><label><input id="closeOrderSplitBill" type="checkbox" /> Amount split (Cash + UPI)</label></div>
            <div class="field" id="closeOrderPaymentModeField" hidden><label for="closeOrderPaymentMode">Payment mode</label><select id="closeOrderPaymentMode"><option value="cash" selected>Cash</option><option value="card">Card</option><option value="upi">UPI</option></select></div>
            <div class="field" id="closeOrderSingleAmountField" style="display:none;"><label for="closeOrderSingleAmount">Amount received</label><input id="closeOrderSingleAmount" type="number" step="0.01" min="0" /></div>
            <div class="field" id="closeOrderCardField"  style="display:none;"><label for="closeOrderCardPayment">Card payment</label><input id="closeOrderCardPayment" type="number" step="0.01" min="0" value="0" /></div>
            <div class="field" id="closeOrderCashField" hidden><label for="closeOrderCashPayment">Cash payment</label><input id="closeOrderCashPayment" type="number" step="0.01" min="0" value="0" /></div>
            <div class="field" id="closeOrderUpiField" hidden><label for="closeOrderUpiPayment">UPI payment</label><input id="closeOrderUpiPayment" type="number" step="0.01" min="0" value="0" /></div>
            <div class="field" id="closeOrderOnSpotDiscountField"><label for="closeOrderOnSpotDiscount">On-Spot discount</label><input id="closeOrderOnSpotDiscount" type="number" step="0.01" min="0" value="0" /></div>
            <div class="field"><label><input id="closeOrderNoTax" type="checkbox" /> No Tax</label></div>
            <div class="field"><label for="closeOrderCustomerPhone">Customer phone</label><input id="closeOrderCustomerPhone" type="tel" /></div>
            <div class="field"><label for="closeOrderCustomerName">Customer name</label><input id="closeOrderCustomerName" type="text" /></div>
            <input id="closeOrderCustomerId" type="hidden" />
          </div>
          <p class="muted" id="closeOrderCustomerLookupMessage"></p>
          <p class="muted" id="closeOrderSplitHint"></p>
          <div class="modal-actions">
            <button class="secondary" type="button" id="printCloseOrderReceiptButton">Print</button>
            <button class="secondary" type="submit">Confirm & Close</button>
            <button class="ghost-button" type="button" id="cancelCloseOrderFormButton">Cancel</button>
          </div>
          <p class="muted" id="closeOrderPrintMessage"></p>
          <p class="muted" id="closeOrderSaveMessage"></p>
        </form>
      </div>
    </div>
    <div class="modal-backdrop" id="kotPreviewModalBackdrop" hidden></div>
    <div class="modal-shell" id="kotPreviewModal" role="dialog" aria-modal="true" aria-labelledby="kotPreviewModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="kotPreviewModalTitle">KOT Print Preview</h3>
          </div>
          <button type="button" class="icon-button" id="closeKotPreviewButton" aria-label="Close KOT preview">×</button>
        </div>
        <form id="kotPreviewForm">
          <div class="field hide">
            <label for="kotPaperWidth">Paper width</label>
            <select id="kotPaperWidth">
              <option value="58">58mm thermal roll</option>
              <option value="80" selected>80mm thermal roll</option>
            </select>
          </div>
          <section class="panel kot-selection-panel" id="kotSelectionPanel">
            <div class="section-head kot-selection-head">
              <div>
                <h4>Select items to print</h4>
              </div>
            </div>
            <div id="kotItemSelection"></div>
          </section>
          <section class="panel kot-panel" id="kotPreviewPanel">
            <div id="kotPreviewContent"></div>
          </section>
          <div class="modal-actions">
            <button class="secondary" type="submit">Print</button>
            <button class="ghost-button" type="button" id="cancelKotPreviewButton">Cancel</button>
          </div>
          <p class="muted" id="kotPrintMessage"></p>
        </form>
      </div>
    </div>
   
    <script src="/js/jquery.min.js"></script>
    <!-- <script src="/js/qz-tray.js"></script> -->
    <script src="/js/select2.min.js"></script>
    <script src="/js/shared.js"></script>
    <script src="/js/orders.js"></script>
     <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
      
      // var config = qz.configs.create(PRINTER_NAME);
      // qz.websocket.connect().then(() => {
      //   console.log("Connected to QZ Tray!");
      // }).catch(err => console.error(err));

    </script>
  </body>
</html>
