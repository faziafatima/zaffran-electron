<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
    <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
        
          <div class="page-heading">Sales Report</div>
          <section class="panel reports-filter-panel">
          <div class="reports-filter-grid">
            <div class="field">
              <label for="reportReferenceDateFrom">From</label>
              <input id="reportReferenceDateFrom" type="date" />
            </div>
            <div class="field">
              <label for="reportReferenceDateTo">To</label>
              <input id="reportReferenceDateTo" type="date" />
            </div>
            <div class="field">
              <label for="reportCategoryFilter">Category</label>
              <select id="reportCategoryFilter"><option value="">All categories</option></select>
            </div>
            <div class="reports-filter-actions">
              <button type="button" id="refreshReportButton">Search</button>
              <a href="/reportsView" class="button">Back</a>
            </div>
          </div>
          <p class="muted" id="reportsMessage"></p>
        </section>

         <article class="panel" id="salesSalesPanel">
<h3>Sales Summary<button type="button" class="secondary" style="float:right;" id="salesExportCsvButton">Export CSV</button></h3>
                 <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Total Orders</th>
                  <th>Items Sold</th>
                  <th>Total Cash Payments</th>
                  <th>Total Card Payments</th>
                  <th>Total UPI Payments</th>
                  <th>Total Sales</th>
                  <th>Total Discounts</th>
                  <th>Total Tax</th>
                </tr>
              </thead>
              <tbody id="salesSummaryRows"></tbody>
            </table>
          </div>
        </article>

        
        <article class="panel" id="salesItemsPanel" style="margin-top:20px;">
<h3>Menu Items Sold</h3>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Menu item</th>
                  <th>Category</th>
                  <th>Qty sold</th>
                  <th>Sales</th>
                  <th>Share</th>
                </tr>
              </thead>
              <tbody id="salesItemRows"></tbody>
            </table>
          </div>
        </article>
      </main>
    </div>
    <script>
  
  </script>
    <script src="/js/shared.js"></script>
    <script src="/js/reports-sales.js"></script>
    
  </body>
</html>
