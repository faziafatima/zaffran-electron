<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
    <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
        <div class="topbar">
          
          <div class="page-heading">User Management</div>
          <div class="topbar-actions">
            <button class="secondary" type="button" id="openUserFormButton">Add User</button>
            <a href="/masterPages" class="button">Back</a>
          </div>
        </div>
        <section class="row">
          <div class="panel col">
            <h3>User Records</h3>
            <table class="table">
              <thead>
                <tr><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr>
              </thead>
              <tbody id="usersTableBody"></tbody>
            </table>
          </div>
        </section>
      </main>
    </div>

    <div class="modal-backdrop" id="userModalBackdrop" hidden></div>
    <div class="modal-shell" id="userModal" role="dialog" aria-modal="true" aria-labelledby="userModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="userModalTitle">Add user</h3>
          </div>
          <button type="button" class="icon-button" id="closeUserFormButton" aria-label="Close user form">×</button>
        </div>
        <form id="userForm">
          <div class="triple-grid">
          <div class="field"><label for="userName">Name</label><input id="userName" required /></div>
          <div class="field"><label for="userEmail">Email</label><div><input id="userEmail" type="text" required /><span>@thezaffran.in</span></div></div>
          <div class="field"><label for="userRoleId">Role</label><select id="userRoleId" required></select></div>
          <div class="field"><label for="userRestaurantId">Restaurant</label><select id="userRestaurantId" required></select></div>
          <div class="field"><label for="userPassword">Password</label><input id="userPassword" type="password" required /></div>
          </div>
          <div class="modal-actions">
            <button type="submit">Save User</button>
            <button class="ghost-button" type="button" id="cancelUserFormButton">Cancel</button>
          </div>
          <p class="muted" id="userSaveMessage"></p>
        </form>
      </div>
    </div>

    <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
    </script>
    <script src="/js/shared.js"></script>
    <script src="/js/users.js"></script>
  </body>
</html>
