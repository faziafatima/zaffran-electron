<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" href="../images/favicon.ico">
  </head>
  <body data-role="<%= role %>" data-user="<%= user %>">
   <%- include('../partials/header.ejs') %>
    <div class="app-shell">
      <%- include('../partials/sidebar.ejs') %>
      <main class="main-content">
        <div class="topbar">
          <div class="page-heading">Inventory Management</div>
          <div class="topbar-actions">
            <button class="secondary" type="button" id="openInventoryFormButton">Add Item</button>
            <a href="/masterPages" class="button">Back</a>
          </div>
        </div>
        <section class="row">
          <div class="panel col">
            <div class="section-head">
              <div>
                <h3>Stock Items</h3>
              </div>
              <div class="menu-toolbar">
                <input id="inventorySearchInput" class="menu-search" type="search" aria-label="Search inventory items" placeholder="Search by item or status" />
              </div>
            </div>
            <table class="table">
              <thead>
                <tr><th>Item</th><th>Stock</th><th>Status</th><th>Actions</th></tr>
              </thead>
              <tbody id="inventoryTableBody">
                <% inventory.forEach(item => { %>
                    <tr>
                    <td><%= item.itemName || 'Unnamed item'%><br/> <span class="section-tag">HSN: <%= item.hsnNumber || 'N/A' %></span></td>
                    <td><%= item.quantity ?? 0%> <%= item.unit || ''%></td>
                    <td><span class="status-pill <%= item.statusClass %> "><%= item.status || 'Available' %></span></td>
                    <td>
                      <div class="menu-actions">
                        <% if(role == 'super admin' || role == 'admin') { %>
                        <button type="button" class="menu-action-btn edit" data-inventory-action="edit" data-inventory-id="<%= item.id %>">Edit</button>
                        <% } %>
                        <button type="button" class="menu-action-btn update" data-inventory-action="update" data-inventory-id="<%= item.id %>">Update Inventory</button>
                        <button type="button" class="menu-action-btn delete" data-inventory-action="delete" data-inventory-id="<%= item.id %>">Delete</button>
                      </div>
                    </td>
                  </tr>
                <% }) %>
          
              </tbody>
            </table>
            <div class="table-footer">
              <span class="muted" id="inventoryPageSummary">Showing 0 of 0 items</span>
              <div class="pagination-controls">
                <button type="button" class="secondary pagination-button" id="inventoryPrevButton">Previous</button>
                <span class="muted" id="inventoryPageIndicator">Page 0 of 0</span>
                <button type="button" class="secondary pagination-button" id="inventoryNextButton">Next</button>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>
    <div class="modal-backdrop" id="inventoryModalBackdrop" hidden></div>
    <div class="modal-shell" id="inventoryModal" role="dialog" aria-modal="true" aria-labelledby="inventoryModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="inventoryModalTitle">Stock update</h3>
            <span class="section-tag">Save stock changes from this panel</span>
          </div>
          <button type="button" class="icon-button" id="closeInventoryFormButton" aria-label="Close inventory form">×</button>
        </div>
        <form id="inventoryForm">
          <div class="triple-grid">
          <div class="field"><label for="inventoryName">Item name</label><input id="inventoryName" required /></div>
          <div class="field"><label for="hsnNumber">HSN Number</label><input id="hsnNumber" required /></div>
          <div class="field"><label for="inventoryDescription">Description</label><input id="inventoryDescription" /></div>
          <div class="field"><label for="inventoryQuantity">Quantity</label><input id="inventoryQuantity" type="number" step="0.01" min="0" required /></div>
          <div class="field"><label for="inventoryUnit">Unit</label><select id="inventoryUnit" required><option>kg</option><option>g</option><option>L</option><option>Numbers</option></select></div>
          <div class="field"><label for="inventoryCategory">Category</label><select id="inventoryCategory" required><option>Food</option><option>Non-food</option></select></div>
          <div class="field"><label for="inventoryPrice">Price</label><input id="inventoryPrice" type="number" step="0.01" min="0" required /></div>
          <div class="field"><label for="inventoryStatus">Status</label><select id="inventoryStatus" required><option>Available</option><option>Low Stock</option><option>Out-of-Stock</option></select></div>
          </div>
          <div class="modal-actions">
            <button class="secondary" type="submit">Update Inventory</button>
            <button class="ghost-button" type="button" id="cancelInventoryFormButton">Cancel</button>
          </div>
          <p class="muted" id="inventorySaveMessage"></p>
        </form>
      </div>
    </div>

     <div class="modal-backdrop" id="inventoryUpdateModalBackdrop" hidden></div>
    <div class="modal-shell" id="inventoryUpdateModal" role="dialog" aria-modal="true" aria-labelledby="inventoryUpdateModalTitle" hidden>
      <div class="modal-card panel">
        <div class="section-head modal-head">
          <div>
            <h3 id="inventoryUpdateModalTitle">Today's Inventory Update</h3>
            <span class="section-tag">Save stock changes from this panel</span>
          </div>
          <button type="button" class="icon-button" id="closeInventoryUpdateFormButton" aria-label="Close inventory form">×</button>
        </div>
        <form id="inventoryUpdateForm">
          <div class="double-grid">
          <div class="field"><label for="inventoryUpdateName">Item name</label><input id="inventoryUpdateName" readonly /></div>
          <div class="field"><label for="inventoryUpdateQuantity">Quantity</label><input id="inventoryUpdateQuantity" type="number" step="0.01" min="0" required /></div>
          </div>
          <div class="modal-actions">
            <button class="secondary" type="submit">Update Inventory</button>
            <button class="ghost-button" type="button" id="cancelInventoryUpdateFormButton">Cancel</button>
          </div>
          <p class="muted" id="inventoryUpdateSaveMessage"></p>
        </form>
      </div>
    </div>


    <script>
      window.__APP_CONTEXT__ = {
        role: "<%= role %>",
        user: "<%= user %>",
        restaurant: "<%= restaurant || '' %>"
      };
    </script>
    <script src="/js/shared.js"></script>
    <script src="/js/inventory.js"></script>
  </body>
</html>
